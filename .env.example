# Copia este archivo a .env en la raiz del proyecto y edita los valores.
#   cp .env.example .env
# Genera un JWT_SECRET con:  openssl rand -base64 64

# Dominio publico apuntando (registro A) a la IP de tu VM
DOMAIN=helpdesk.tudominio.com

# Base de datos (elige una contrasena fuerte)
POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=cambia-esto-por-algo-fuerte

# Firma de los tokens JWT (OBLIGATORIO cambiarlo)
JWT_SECRET=genera-uno-largo-y-aleatorio-con-openssl

# Correo de notificaciones (desactivado por defecto)
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=helpdesk@localhost

# Login con Google (opcional; configura el redirect en Google Cloud Console:
# https://TU_DOMINIO/login/oauth2/code/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Pagos Stripe (opcional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
